{
  "expo": {
    "name": "Monopoly Banker",
    "slug": "monopoly-helper",
    "version": "1.3.1",
    "orientation": "portrait",
    "scheme": "monopolybanker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.patteruel.monopolybanker",
      "appleTeamId": "2ZL598ZSDC",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Monopoly Banker connects to your host's phone directly over your local Wi-Fi network to sync this table's game."
      }
    },
    "android": {
      "package": "dev.patteruel.monopolybanker",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Monopoly Banker to use the camera to scan a host's QR code when joining a table."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79ce84c4-5868-4ce2-977c-79569035af49"
      }
    },
    "owner": "jpteruel95"
  }
}
